# Full environment override template for existing/development deployments.
# For a fresh Docker browser installation, prefer .env.docker.example so Talvoro
# can generate APP_KEY and application settings into protected storage/config.php.

APP_NAME="My Website"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Ljubljana
APP_KEY=

DB_HOST=db
DB_PORT=3306
DB_DATABASE=talvoro
DB_USERNAME=talvoro
DB_PASSWORD=change-this-app-password
DB_ROOT_PASSWORD=change-this-root-password

SESSION_LIFETIME=120
ANALYTICS_ENABLED=true
ANALYTICS_RESPECT_DNT=true
ANALYTICS_IGNORE_BOTS=true
