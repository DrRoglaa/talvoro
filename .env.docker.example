# Talvoro Docker bootstrap configuration.
# Copy this file to .env and replace all three password values before first start.
# Application settings and APP_KEY are created by the browser installer and stored
# in protected storage/config.php. Existing deployments may keep their current .env.

DB_DATABASE=talvoro
DB_USERNAME=talvoro
DB_PASSWORD=replace-with-a-long-random-database-password
DB_ROOT_PASSWORD=replace-with-a-different-long-random-root-password
